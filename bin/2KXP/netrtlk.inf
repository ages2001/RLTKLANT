; netrtlk.inf - RLTKLANT: Realtek LAN family NDIS miniport (universal)
;
; ONE INF for Windows 2000, XP (x86) and XP x64 / Server 2003 x64, covering
; BOTH the PCI/PCIe parts (PCI\VEN_10EC...) and the USB parts
; (USB\VID_0BDA...).  The 32-bit driver is in i386\, the 64-bit driver in
; amd64\; SetupAPI picks the right one per architecture.  Each hardware id
; carries its own name; the driver refines it to the exact chip at run time.
;
; Copyright (C) 2026 ages2001.

[version]
Signature="$Windows NT$"
Class=Net
ClassGUID={4d36e972-e325-11ce-bfc1-08002be10318}
Provider=%Provider%
DriverVer=10/28/2026,1.0.0.0
CatalogFile=rltklant.cat

[Manufacturer]
%Realtek%=Realtek, NTamd64

